# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only. Never prefixed NEXT_PUBLIC_ — it bypasses row level security and is
# used for exactly one thing: rendering read-only share links for family members.
# Project Settings → API Keys → Secret keys → "Create new secret key".
# Older projects can use their service_role JWT as SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Used for magic-link redirects and for printing share URLs.
# Locally: http://localhost:3000 — on Vercel: https://travel-planner-xxxx.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
